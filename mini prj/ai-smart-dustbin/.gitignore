# Combined .gitignore for Smart Waste Dashboard

# IDEs and Editors
.vscode/
.idea/
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db

# Backend (Python/FastAPI)
backend/venv/
backend/.env
backend/__pycache__/
backend/*.pyc
backend/.pytest_cache/

# Frontend (Node/React/Vite)
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
frontend/*.local
frontend/.eslintcache

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
backend/*.log

# Build artifacts
build/
bin/
obj/
